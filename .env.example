# Configuración del Servidor CareDent Nube
PORT=3000
NODE_ENV=production

# Clave secreta para firma de tokens JWT (generar una clave aleatoria segura)
SECRET_KEY=cambiar_por_una_clave_secreta_super_segura_aqui

# Base de Datos en la Nube (Turso / LibSQL)
TURSO_DATABASE_URL=libsql://tu-base-de-datos.turso.io
TURSO_AUTH_TOKEN=tu_token_de_turso_aqui
